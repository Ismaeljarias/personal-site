---
import { siteConfig } from '../site.config';

interface Props {
  heading: string;
  cta: string;
  body?: string;
}

const { heading, cta, body } = Astro.props;
---

<section class="border-t border-border">
  <div class="mx-auto max-w-4xl px-6 py-12 sm:py-24 text-center" data-reveal>
    <h2 class="text-balance text-3xl font-serif font-semibold tracking-tight text-ink sm:text-4xl">{heading}</h2>
    {body && <p class="mx-auto mt-4 max-w-xl text-ink-muted">{body}</p>}
    <a
      href={siteConfig.calendlyUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 inline-flex items-center gap-2 rounded-[8px] bg-accent px-6 py-3 text-sm font-medium text-ink transition-opacity hover:opacity-90"
    >
      {cta}
    </a>
  </div>
</section>
