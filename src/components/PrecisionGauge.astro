---
interface Props {
  value: number;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="relative mx-auto h-28 w-28 shrink-0 sm:h-32 sm:w-32" aria-hidden="true">
  <svg viewBox="0 0 100 100" class="h-full w-full">
    <path
      d="M 21.72 78.28 A 40 40 0 1 1 78.28 78.28"
      fill="none"
      stroke="var(--color-border)"
      stroke-width="3"
      stroke-linecap="round"
    />
    <path
      d="M 21.72 78.28 A 40 40 0 1 1 78.28 78.28"
      fill="none"
      stroke="var(--color-brass)"
      stroke-width="3"
      stroke-linecap="round"
      pathLength="1"
      class="draw"
    />
  </svg>
  <div class="absolute inset-0 flex flex-col items-center justify-center">
    <span class="font-serif text-2xl font-semibold text-ink">{value}</span>
    <span class="font-mono text-[10px] uppercase tracking-widest text-ink-faint">{label}</span>
  </div>
</div>
