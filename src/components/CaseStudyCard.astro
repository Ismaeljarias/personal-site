---
interface Props {
  company: string;
  role: string;
  title: string;
  problem: string;
  action: string;
  result: string;
  labels: { problem: string; action: string; result: string };
  delay?: number;
}

const { company, role, title, problem, action, result, labels, delay = 0 } = Astro.props;
---

<article
  data-reveal
  data-reveal-delay={delay}
  class="rounded-2xl border border-border bg-bg-card p-8"
>
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <p class="text-xs font-medium uppercase tracking-widest text-accent">{company} — {role}</p>
  </div>
  <h2 class="mt-3 text-xl font-semibold text-ink">{title}</h2>

  <dl class="mt-6 space-y-5">
    <div>
      <dt class="text-xs font-medium uppercase tracking-wider text-ink-faint">{labels.problem}</dt>
      <dd class="mt-1.5 text-sm leading-relaxed text-ink-muted">{problem}</dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wider text-ink-faint">{labels.action}</dt>
      <dd class="mt-1.5 text-sm leading-relaxed text-ink-muted">{action}</dd>
    </div>
    <div>
      <dt class="text-xs font-medium uppercase tracking-wider text-ink-faint">{labels.result}</dt>
      <dd class="mt-1.5 text-sm leading-relaxed text-ink-muted">{result}</dd>
    </div>
  </dl>
</article>
