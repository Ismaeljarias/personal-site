---
import { t, localePath, type Locale } from '../i18n/content';
import { siteConfig } from '../site.config';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang);

const links = [
  { href: localePath(lang, '/'), label: copy.nav.home },
  { href: localePath(lang, '/shopify'), label: copy.nav.shopify },
  { href: localePath(lang, '/wordpress'), label: copy.nav.wordpress },
  { href: localePath(lang, '/work'), label: copy.nav.work },
  { href: localePath(lang, '/contact'), label: copy.nav.contact },
];
---

<footer class="border-t border-border">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 sm:grid-cols-3">
    <div>
      <p class="font-serif text-2xl font-medium text-ink">{siteConfig.name}<span class="text-brass">.</span></p>
      <p class="mt-2 max-w-xs text-sm text-ink-muted">{copy.footer.tagline}</p>
    </div>

    <div>
      <p class="text-sm font-medium text-ink">{copy.footer.linksHeading}</p>
      <ul class="mt-3 space-y-2 text-sm text-ink-muted">
        {links.map((link) => (
          <li><a href={link.href} class="transition-colors hover:text-ink">{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-sm font-medium text-ink">{copy.footer.contactHeading}</p>
      <ul class="mt-3 space-y-2 text-sm text-ink-muted">
        <li><a href={`mailto:${siteConfig.email}`} class="transition-colors hover:text-ink">{siteConfig.email}</a></li>
        <li><a href={siteConfig.linkedin} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-ink">LinkedIn</a></li>
        <li><a href={siteConfig.github} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-ink">GitHub</a></li>
        <li class="pt-1 text-ink-faint">{siteConfig.location}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-border px-6 py-6 text-center text-xs text-ink-faint">
    {copy.footer.rights}
  </div>
</footer>
