---
import BaseLayout from '../layouts/BaseLayout.astro';
import WordPressView from '../views/WordPressView.astro';
import { t } from '../i18n/content';

const lang = 'en' as const;
const meta = t(lang).meta;
---

<BaseLayout lang={lang} title={`WordPress & Dynamic Sites — ${meta.titleSuffix}`} description={meta.description}>
  <WordPressView lang={lang} />
</BaseLayout>
