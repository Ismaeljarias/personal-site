---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactView from '../views/ContactView.astro';
import { t } from '../i18n/content';
import ogImage from '../assets/og/contact-en.png';

const lang = 'en' as const;
const meta = t(lang).meta;
---

<BaseLayout lang={lang} title={`Contact — ${meta.titleSuffix}`} description={meta.description} image={ogImage}>
  <ContactView lang={lang} />
</BaseLayout>
