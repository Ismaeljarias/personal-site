---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShopifyView from '../views/ShopifyView.astro';
import { t } from '../i18n/content';
import ogImage from '../assets/og/shopify-en.png';

const lang = 'en' as const;
const copy = t(lang);
---

<BaseLayout lang={lang} title={`Shopify Plus & Hydrogen Development — ${copy.meta.titleSuffix}`} description={copy.shopify.metaDescription} image={ogImage}>
  <ShopifyView lang={lang} />
</BaseLayout>
