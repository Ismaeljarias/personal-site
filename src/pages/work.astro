---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkView from '../views/WorkView.astro';
import { t } from '../i18n/content';
import ogImage from '../assets/og/work-en.png';

const lang = 'en' as const;
const meta = t(lang).meta;
---

<BaseLayout lang={lang} title={`Case Studies — ${meta.titleSuffix}`} description={meta.description} image={ogImage}>
  <WorkView lang={lang} />
</BaseLayout>
