---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShopifyView from '../../views/ShopifyView.astro';
import { t } from '../../i18n/content';
import ogImage from '../../assets/og/shopify-es.png';

const lang = 'es' as const;
const copy = t(lang);
---

<BaseLayout lang={lang} title={`Desarrollo Shopify Plus & Hydrogen — ${copy.meta.titleSuffix}`} description={copy.shopify.metaDescription} image={ogImage}>
  <ShopifyView lang={lang} />
</BaseLayout>
