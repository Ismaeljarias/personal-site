---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkView from '../../views/WorkView.astro';
import { t } from '../../i18n/content';
import ogImage from '../../assets/og/work-es.png';

const lang = 'es' as const;
const meta = t(lang).meta;
---

<BaseLayout lang={lang} title={`Casos de Éxito — ${meta.titleSuffix}`} description={meta.description} image={ogImage}>
  <WorkView lang={lang} />
</BaseLayout>
