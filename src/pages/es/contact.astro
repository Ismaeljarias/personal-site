---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactView from '../../views/ContactView.astro';
import { t } from '../../i18n/content';
import ogImage from '../../assets/og/contact-es.png';

const lang = 'es' as const;
const meta = t(lang).meta;
---

<BaseLayout lang={lang} title={`Contacto — ${meta.titleSuffix}`} description={meta.description} image={ogImage}>
  <ContactView lang={lang} />
</BaseLayout>
