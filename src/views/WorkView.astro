---
import { getCollection } from 'astro:content';
import { t, localePath, type Locale } from '../i18n/content';
import CaseStudyPreview from '../components/CaseStudyPreview.astro';
import CTABanner from '../components/CTABanner.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang).work;

const caseStudies = (await getCollection('work', (entry) => entry.id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section class="mx-auto max-w-5xl px-6 pb-16 pt-12 sm:pt-32">
  <p class="text-sm font-medium uppercase tracking-widest text-brass font-mono" data-reveal>{copy.eyebrow}</p>
  <h1 class="mt-5 max-w-3xl text-balance text-4xl font-serif font-semibold tracking-tight text-ink sm:text-5xl" data-reveal data-reveal-delay={0.08}>
    {copy.h1}
  </h1>
  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted" data-reveal data-reveal-delay={0.16}>
    {copy.sub}
  </p>
</section>

<section class="border-t border-border">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-6 lg:grid-cols-3">
      {caseStudies.map((entry, i) => (
        <CaseStudyPreview
          title={entry.data.title}
          client={entry.data.client}
          role={entry.data.role}
          summary={entry.data.summary}
          stack={entry.data.stack}
          href={localePath(lang, `/work/${entry.id.split('/')[1]}`)}
          cta={copy.cardCta}
          delay={i * 0.08}
        />
      ))}
    </div>
  </div>
</section>

<CTABanner heading={copy.finalHeading} cta={copy.finalCta} />
