---
import { t, type Locale } from '../i18n/content';
import { siteConfig } from '../site.config';
import ServiceCard from '../components/ServiceCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CTABanner from '../components/CTABanner.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang).shopify;
---

<section class="mx-auto max-w-5xl px-6 pb-16 pt-12 sm:pt-32">
  <p class="text-sm font-medium uppercase tracking-widest text-accent" data-reveal>{copy.eyebrow}</p>
  <h1 class="mt-5 max-w-3xl text-balance text-4xl font-semibold tracking-tight text-ink sm:text-5xl" data-reveal data-reveal-delay={0.08}>
    {copy.h1}
  </h1>
  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted" data-reveal data-reveal-delay={0.16}>
    {copy.sub}
  </p>
  <a
    href={siteConfig.calendlyUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-9 inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-medium text-bg transition-opacity hover:opacity-90"
    data-reveal
    data-reveal-delay={0.24}
  >
    {copy.ctaPrimary}
  </a>
</section>

<section class="border-t border-border">
  <div class="mx-auto max-w-5xl px-6 py-14">
    <a
      href={copy.app.url}
      target="_blank"
      rel="noopener noreferrer"
      class="group flex flex-col gap-4 rounded-2xl border border-border bg-bg-card p-8 transition-colors hover:border-accent/50 sm:flex-row sm:items-center sm:justify-between"
      data-reveal
    >
      <div>
        <p class="text-xs font-medium uppercase tracking-widest text-accent">{copy.app.eyebrow}</p>
        <h2 class="mt-2 text-xl font-semibold text-ink">{copy.app.heading}</h2>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-muted">{copy.app.body}</p>
      </div>
      <span class="inline-flex shrink-0 items-center gap-1 text-sm font-medium text-accent">
        {copy.app.cta} <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
      </span>
    </a>
  </div>
</section>

<section class="border-t border-border">
  <div class="mx-auto max-w-6xl px-6 py-12 sm:py-24">
    <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl" data-reveal>{copy.servicesHeading}</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {copy.services.map((service, i) => (
        <ServiceCard title={service.title} description={service.description} delay={i * 0.08} />
      ))}
    </div>
  </div>
</section>

<section id="audit" class="scroll-mt-24 border-t border-border">
  <div class="mx-auto max-w-4xl px-6 py-12 sm:py-24">
    <div class="rounded-2xl border border-accent/30 bg-bg-card p-10 text-center sm:p-14" data-reveal>
      <p class="text-xs font-medium uppercase tracking-widest text-accent">{copy.audit.eyebrow}</p>
      <h2 class="mt-3 text-balance text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{copy.audit.heading}</h2>
      <p class="mx-auto mt-4 max-w-xl text-ink-muted">{copy.audit.body}</p>
      <p class="mt-6 text-lg font-semibold text-ink">{copy.audit.price}</p>
      <a
        href={siteConfig.calendlyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-medium text-bg transition-opacity hover:opacity-90"
      >
        {copy.audit.cta}
      </a>
    </div>
  </div>
</section>

<ProcessSteps heading={copy.processHeading} steps={copy.process} />

<CTABanner heading={copy.finalHeading} cta={copy.finalCta} />
